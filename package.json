{
  "name": "hushtest",
  "version": "0.0.1",
  "description": "Agent-first API testing CLI. Pre-release placeholder.",
  "type": "module",
  "bin": {
    "hushtest": "bin/hushtest.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prasdud/hushtest.git"
  },
  "keywords": [
    "api",
    "testing",
    "agents",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
